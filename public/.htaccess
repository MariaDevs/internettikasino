Options -MultiViews
RewriteEngine On

# Force HTTPS and the bare domain (canonical host, same as the WordPress site)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://internettikasino.com%{REQUEST_URI} [L,R=301]

# XML-RPC was a WordPress attack surface; nothing lives there now
RewriteRule ^xmlrpc\.php$ - [F,L]

# Legacy WordPress URLs → current equivalents (generated by scripts/generate-redirects.mjs)
RewriteRule ^go/casinofriday/?$ /go/casino-friday/ [L,R=301]
RewriteRule ^list(/.*)?/?$ /parhaat-kasinot/ [L,R=301]
RewriteRule ^kierratysvapaat-bonukset/?$ /ilmaiskierrokset/ [L,R=301]
RewriteRule ^kierratysvapaat-ilmaiskierrokset/?$ /ilmaiskierrokset/ [L,R=301]
RewriteRule ^nettikasino-ilman-rekisteroitymista/?$ /kasino-ilman-rekisteroitymista/ [L,R=301]
RewriteRule ^paras-nettikasino/?$ /parhaat-kasinot/ [L,R=301]
RewriteRule ^parhaat-nettikasinot/?$ /parhaat-kasinot/ [L,R=301]
RewriteRule ^homepage/?$ / [L,R=301]
RewriteRule ^feed/?$ / [L,R=301]
RewriteRule ^(.+/)?feed/?$ / [L,R=301]
RewriteRule ^slider(/.*)?/?$ / [L,R=301]
RewriteRule ^category/uncategorized/?$ /category/oppaat/ [L,R=301]
RewriteRule ^wp-admin(/.*)?/?$ / [L,R=301]
RewriteRule ^wp-login\.php/?$ / [L,R=301]
RewriteRule ^wp-json(/.*)?/?$ / [L,R=301]

# Affiliate links (/go/<slug>/) — 302 so the target can change without being cached as permanent
RewriteRule ^go/247bet/?$ https://media1.casimbaaff.com/redirect.aspx?pid=54812&lpid=301&bid=1728 [L,R=302,NE]
RewriteRule ^go/casino-friday/?$ https://go.funnz.partners/visit/?bta=38445&nci=5599&utm_campaign=FICF [L,R=302,NE]
RewriteRule ^go/hurmio/?$ https://record.njordaffiliates.com/_9E0BOAU0a4TZnhMrthbTn2Nd7ZgqdRLk/1/ [L,R=302,NE]
RewriteRule ^go/igni/?$ https://media1.casimbaaff.com/redirect.aspx?pid=54824&lpid=60&bid=1522 [L,R=302,NE]
RewriteRule ^go/jackburst/?$ https://node1.spincdnjb.com/_GpV01n98OwXUOsjNOfgKeWNd7ZgqdRLk/1/ [L,R=302,NE]
RewriteRule ^go/jellona/?$ https://record.njordaffiliates.com/_9E0BOAU0a4RMzvGV4MrLVGNd7ZgqdRLk/2/ [L,R=302,NE]
RewriteRule ^go/kaahaus/?$ https://go.fruitypartners.com/visit/?bta=35381&brand=kaahaus&utm_campaign=FIKA [L,R=302,NE]
RewriteRule ^go/lumo/?$ https://media1.casimbaaff.com/redirect.aspx?pid=54814&bid=1499&lpid=125 [L,R=302,NE]
RewriteRule ^go/munkki/?$ https://oneupengine.com/C.ashx?btag=a_5404b_144c_&affid=1031&siteid=5404&adid=144&c= [L,R=302,NE]
RewriteRule ^go/onerush/?$ https://record.epic.partners/_Tp2xlTM-kcXlD9UB4eAeYmNd7ZgqdRLk/1/ [L,R=302,NE]
RewriteRule ^go/pelipeto/?$ https://go.funnz.partners/visit/?bta=38445&nci=5832&utm_campaign=FIPE [L,R=302,NE]
RewriteRule ^go/rullat/?$ https://record.njordaffiliates.com/_9E0BOAU0a4Q1X8vVweHoG2Nd7ZgqdRLk/3/ [L,R=302,NE]
RewriteRule ^go/shotz/?$ https://go.funnz.partners/visit/?bta=38445&nci=5808&utm_campaign=FISHZ [L,R=302,NE]
RewriteRule ^go/spiidi/?$ https://go.fruitypartners.com/visit/?bta=35381&brand=spiidi&utm_campaign=SPIIDIFI [L,R=302,NE]
RewriteRule ^go/spinnair/?$ https://go.fruitypartners.com/visit/?bta=35381&brand=spinnair&utm_campaign=FIAIR [L,R=302,NE]
RewriteRule ^go/spinnaus/?$ https://go.fruitypartners.com/visit/?bta=35381&brand=spinnaus&utm_campaign=FISPI [L,R=302,NE]
RewriteRule ^go/taika-spinni/?$ https://Media1.casimbacuraff.com/redirect.aspx?pid=55101&lpid=331&bid=1759 [L,R=302,NE]
RewriteRule ^go/tikkari/?$ https://record.njordaffiliates.com/_9E0BOAU0a4Sk07jEtR6iDWNd7ZgqdRLk/5/ [L,R=302,NE]
RewriteRule ^go/ursa/?$ https://media1.casimbaaff.com/redirect.aspx?pid=54825&bid=1621&lpid=215 [L,R=302,NE]
RewriteRule ^go/vauthi/?$ https://media1.casimbaaff.com/redirect.aspx?pid=54822&lpid=85&bid=1526 [L,R=302,NE]
RewriteRule ^go/pelifantti/?$ https://record.njordaffiliates.com/_9E0BOAU0a4TwFyzdGofsLGNd7ZgqdRLk/12731/ [L,R=302,NE]
RewriteRule ^go/titaani/?$ https://go.fruitypartners.com/visit/?bta=35381&brand=titaani&utm_campaign=FITIT [L,R=302,NE]

# Enforce trailing slash on page URLs (matches WordPress + canonical tags)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# 404 fallback
ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^go">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
